# Copy to .env (or set these in your hosting dashboard). Never commit real values.

PORT=3000

# First admin account (used only when the database has no users yet)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Where the database and uploads live. On a host, point these at a persistent disk.
# DATA_DIR=/var/data/db
# UPLOAD_DIR=/var/data/uploads

# Set to 1 when running behind a proxy/load balancer that terminates HTTPS
# (Render, Railway, Nginx, Cloudflare). Makes the login cookie HTTPS-only.
TRUST_PROXY=1

# Max upload size per file, in MB
MAX_UPLOAD_MB=100

# Email notifications for the contact form (optional; messages are always saved in Admin > Messages)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Portfolio <you@gmail.com>"
