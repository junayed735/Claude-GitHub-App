{
  "name": "growth-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio and CMS for a media buying and growth specialist",
  "main": "server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
